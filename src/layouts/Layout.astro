---
import '@fontsource-variable/dm-sans';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, href } from '../data/site';
interface Props { title: string; description?: string; overlay?: boolean; }
const { title, description = site.description, overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: new URL(href('/'), Astro.site).href, description, inLanguage: 'en-IN' };
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#263f32"/>
    <title>{title} | {site.name}</title><meta name="description" content={description}/>
    <meta name="robots" content={site.live ? 'index,follow' : 'noindex,nofollow'}/>
    <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={href('/favicon.svg')}/>
    <link rel="sitemap" href={href('/sitemap-index.xml')}/>
    <meta property="og:type" content="website"/><meta property="og:locale" content="en_IN"/><meta property="og:site_name" content={site.name}/>
    <meta property="og:title" content={`${title} | ${site.name}`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content={new URL(href('/social.jpg'), Astro.site)}/><meta property="og:image:alt" content="Green hills — Etern Destinations inspiration photograph"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay}/>
    <main id="main"><slot/></main>
    <Footer/>
  </body>
</html>
