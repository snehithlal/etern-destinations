---
import { Image } from 'astro:assets';
import { ArrowUpRight, House, Mountain, Coffee } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import StayCTA from '../components/StayCTA.astro';
import { photos } from '../data/photos';
import { href } from '../data/site';
---
<Layout title="The cottage" description="Explore a whole-cottage retreat at Etern Destinations in Wayanad. Discover the idea behind the stay and get in touch to confirm the details for your visit.">
  <PageHeading label="A PLACE TO CALL YOUR OWN" title="Settle into something slower." description="A whole cottage. A different pace. A little time to reconnect."/>
  <div class="container wide-photo"><Image src={photos.cottage.src} alt={photos.cottage.alt} widths={[640, 960, 1440, 2000]} sizes="90vw" loading="eager"/><span class="image-note">INSPIRATION PHOTOGRAPH — PROPERTY IMAGES COMING SOON</span></div>
  <section class="section-space container intro-grid"><div><span class="eyebrow">THE STAY</span><h2>Your time.<br/>Your people.<br/><em>Your own space.</em></h2></div><div class="intro-body"><p class="lead">Etern Destinations is planned as one whole-cottage stay in Wayanad, Kerala.</p><p>Whether your idea of a getaway is a slow start or a day spent exploring, the intention is simple: a comfortable base and the freedom to make the trip your own.</p><p>We’re bringing the finer details together. Please confirm the cottage’s capacity, rooms, facilities, accessibility, inclusions and house rules with the host before making travel plans.</p><a class="text-link" href={href('/contact/')}>Talk about your stay <ArrowUpRight size={18}/></a></div></section>
  <section class="container facts-grid"><article><House stroke-width={1.2}/><h3>The whole cottage</h3><p>One reservation for the property. Guest capacity and room details will be confirmed by the host.</p></article><article><Mountain stroke-width={1.2}/><h3>A Wayanad escape</h3><p>A base for discovering the region. The exact location and directions will be shared once verified.</p></article><article><Coffee stroke-width={1.2}/><h3>The finer details</h3><p>Ask about meals, parking, connectivity, check-in times and anything that makes your stay comfortable.</p></article></section>
  <section class="container section-space"><div class="section-heading"><div><span class="eyebrow">BEFORE YOU ARRIVE</span><h2>A few useful things.</h2></div></div><div class="faq-list">{[
    ['Is this a whole-cottage booking?', 'Yes, the booking model is for one whole cottage. The host will confirm the maximum number of guests and the sleeping arrangements.'],
    ['What amenities are included?', 'The final amenity list is being confirmed. Please ask the host about Wi-Fi, meals, kitchen access, parking and any requirements important to your visit.'],
    ['Can I bring children or pets?', 'Family and pet policies are not yet published. Confirm your party’s needs with the host before booking.'],
    ['What are the prices and cancellation terms?', 'Rates, minimum stays, check-in times and cancellation terms will be provided with your booking offer. There are no live rates or instant bookings on this preview website.'],
  ].map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <StayCTA/>
</Layout>
