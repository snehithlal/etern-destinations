---
import { Image } from 'astro:assets';
import { ArrowDown, ArrowUpRight, Leaf, Mountain, Sun, Compass } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import StayCTA from '../components/StayCTA.astro';
import { photos } from '../data/photos';
import { href } from '../data/site';
---
<Layout title="A cottage retreat in Wayanad" overlay>
  <section class="hero" aria-labelledby="hero-title">
    <Image src={photos.hills.src} alt={photos.hills.alt} widths={[640, 960, 1440, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-image"/>
    <div class="hero-shade"></div>
    <div class="hero-copy container">
      <span class="eyebrow hero-eyebrow"><span></span> WAYANAD, KERALA</span>
      <h1 id="hero-title">Somewhere quieter.<br/><em>Something more.</em></h1>
      <p>A cottage escape in the hills of Wayanad.<br/>For slow mornings and the simple joy of being here.</p>
      <a class="button button-light" href={href('/cottage/')}>Discover your escape <ArrowUpRight size={18}/></a>
    </div>
    <div class="hero-bottom container"><span>LESS HURRY. MORE HERE.</span><a href="#welcome">A little further down <ArrowDown size={16}/></a><span>11° N &nbsp; 76° E <span class="coordinate-label">/ WAYANAD REGION</span></span></div>
  </section>
  <section id="welcome" class="intro section-space container">
    <div class="intro-top"><span class="eyebrow"><span class="tiny-line"></span> A DIFFERENT RHYTHM</span><span class="section-index">01 / THE FEELING</span></div>
    <div class="intro-grid"><h2>Some places ask you<br/>to do more.<br/><em>Here, just be.</em></h2><div class="intro-body"><p class="lead">Trade the everyday rush for a little space, a little green, and a slower kind of stay.</p><p>Welcome to Etern Destinations. A cottage retreat in Wayanad, imagined around the things that make a getaway feel good: time together, fresh perspectives, and days without a packed itinerary.</p><a class="text-link" href={href('/cottage/')}>Meet the cottage <ArrowUpRight size={18}/></a></div></div>
  </section>
  <section class="cottage-feature container">
    <div class="feature-image"><Image src={photos.cottage.src} alt={photos.cottage.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 55vw, 100vw"/><span class="image-note">INSPIRATION / THE STAY</span></div>
    <div class="feature-copy"><span class="eyebrow">YOUR LITTLE CORNER OF WAYANAD</span><h2>A place to settle in.<br/><em>And switch off.</em></h2><p>A whole-cottage stay, with room to make the day your own. Come for a change of scenery. Stay for the feeling of having nowhere else to be.</p><div class="feature-detail"><Leaf size={20}/><span>Nature at the heart of it</span></div><div class="feature-detail"><Sun size={20}/><span>Made for unhurried days</span></div><div class="feature-detail"><Mountain size={20}/><span>Wayanad, Kerala</span></div><a class="button button-outline" href={href('/cottage/')}>Explore the cottage <ArrowUpRight size={17}/></a></div>
  </section>
  <section class="moments section-space container">
    <div class="section-heading"><div><span class="eyebrow">THE ART OF DOING A LITTLE LESS</span><h2>Little moments.<br/><em>Lasting memories.</em></h2></div><p>No checklist required. Just a few good reasons<br class="desktop-break"/> to give yourself a change of pace.</p></div>
    <div class="moment-grid">
      {[{ photo: photos.room, number: '01', title: 'Wake up slowly', text: 'Let the morning arrive on its own terms.' }, { photo: photos.forest, number: '02', title: 'Follow the green', text: 'Find a little perspective along the way.' }, { photo: photos.morning, number: '03', title: 'Stay in the moment', text: 'Make time for the people you came with.' }].map(item => <article class="moment-card"><div class="moment-image"><Image src={item.photo.src} alt={item.photo.alt} widths={[400, 640, 900]} sizes="(min-width: 900px) 30vw, (min-width: 600px) 45vw, 100vw"/><span>{item.number}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
    <a class="text-link" href={href('/gallery/')}>A glimpse of the feeling <ArrowUpRight size={18}/></a>
  </section>
  <section class="explore-band"><div class="explore-photo"><Image src={photos.tea.src} alt={photos.tea.alt} widths={[640, 960, 1440]} sizes="(min-width: 900px) 55vw, 100vw"/></div><div class="explore-copy"><Compass size={30} stroke-width={1}/><span class="eyebrow">WANDER A LITTLE</span><h2>There’s a whole<br/>Wayanad out there.<br/><em>Go gently.</em></h2><p>Green hills, winding roads, and a landscape that invites a closer look. Leave a little space in your plans for the unexpected.</p><a class="text-link" href={href('/explore/')}>Explore the surroundings <ArrowUpRight size={18}/></a></div></section>
  <StayCTA/>
</Layout>
