---
import Layout from '../layouts/Layout.astro';
import { href } from '../data/site';
import { ArrowUpRight } from '@lucide/astro';
---
<Layout title="Page not found"><section class="container page-heading not-found"><span class="eyebrow">404 / A LITTLE OFF THE PATH</span><h1>Let’s find your way back.</h1><p>This page may have moved, or the address might be a little off.</p><a class="button" href={href('/')}>Back to the cottage <ArrowUpRight size={18}/></a></section></Layout>
