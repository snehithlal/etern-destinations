---
import { Image } from 'astro:assets';
import { ArrowUpRight, Leaf, Compass, CloudRain } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import StayCTA from '../components/StayCTA.astro';
import { photos } from '../data/photos';
import { href } from '../data/site';
---
<Layout title="Explore Wayanad" description="Find inspiration for an unhurried visit to Wayanad, Kerala, with Etern Destinations. Plan time in nature and ask the host for local guidance.">
  <PageHeading label="A LITTLE FURTHER AFIELD" title="Follow your curiosity." description="Leave space for a scenic turn, a longer conversation, or a day with no particular destination."/>
  <div class="container wide-photo"><Image src={photos.tea.src} alt={photos.tea.alt} widths={[640, 960, 1440, 2000]} sizes="90vw" loading="eager"/><span class="image-note">INSPIRATION / GREEN HORIZONS</span></div>
  <section class="container intro-grid section-space"><h2>Out here,<br/><em>take the long way.</em></h2><div class="intro-body"><p class="lead">Make a little time for Wayanad.</p><p>Use the cottage as a starting point for a stay shaped around your interests. Ask the host for current local suggestions, suitable routes and any access requirements before setting off.</p><a class="text-link" href={href('/contact/')}>Ask for local recommendations <ArrowUpRight size={18}/></a></div></section>
  <section class="container facts-grid explore-facts"><article><Leaf stroke-width={1.2}/><h3>Find your green</h3><p>Plan time outdoors at a pace that suits you. Choose guided or permitted routes and respect local restrictions.</p></article><article><Compass stroke-width={1.2}/><h3>Keep it local</h3><p>Ask about local food, small businesses and experiences that fit your travel dates and interests.</p></article><article><CloudRain stroke-width={1.2}/><h3>Let the weather lead</h3><p>Keep plans flexible. Check current forecasts, road conditions and visitor access before travelling.</p></article></section>
  <section class="container travel-note"><span class="eyebrow">A NOTE ON PLANNING</span><h3>Good trips begin with a few good questions.</h3><p>Exact distances, travel times and nearby attractions will be added once the cottage location is confirmed. For current destination information, visit <a href="https://www.keralatourism.org/wayanad/" target="_blank" rel="noopener noreferrer">Kerala Tourism’s Wayanad guide <ArrowUpRight size={14}/></a>.</p></section>
  <StayCTA/>
</Layout>
